{
  "name": "markdownre",
  "version": "0.1.0",
  "description": "Markdown reader and editor for Windows, Linux and macOS",
  "scripts": {
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "start:desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "dist:portable": "npm run build && electron-builder --win zip --linux tar.gz --x64 --publish never -c.win.signExecutable=false",
    "test:desktop": "npm run build && node tests/desktop-smoke.cjs && node tests/desktop-pdf-tables.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "lucide-static": "0.503.0",
    "monaco-editor": "^0.57.0",
    "playwright": "1.64.1",
    "rehype-highlight": "^7.0.2",
    "rehype-mathjax": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.5"
  },
  "private": true,
  "type": "module",
  "author": "RayStudioLabs",
  "main": "desktop/main.cjs",
  "license": "MIT"
}
